[Unit]
Description=M3200 OpenUI agent (QMI JSON API + dashboard)
After=network.target
# QRTR/NS and the modem must be up; be generous on boot
StartLimitIntervalSec=0

[Service]
Type=simple
UMask=0077
ExecStart=/usr/bin/python3 /data/m3200-openui/m3200_agent.py --host 192.168.1.1 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
